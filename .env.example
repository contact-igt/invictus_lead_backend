# --- Runo CRM: Birthwave website + landing-page leads (backend-to-backend) ---
# Additive downstream copy only; DB and Google Sheet remain the primary flow.
# The Website Form API URL is account/form-specific: set it ONLY in the
# deployment environment, never commit the real value.
RUNO_BIRTHWAVE_ENABLED=false
RUNO_BIRTHWAVE_WEBSITE_FORM_API_URL=
RUNO_BIRTHWAVE_TIMEOUT_MS=8000
# How the phone is presented to Runo: national (9898989898, default) | e164 (+919898989898) | digits (919898989898)
RUNO_BIRTHWAVE_PHONE_FORMAT=national
