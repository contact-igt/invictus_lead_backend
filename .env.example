# Invictus backend environment template. Copy to .env and fill in real values.

INVICTUS_SERVER_LINE="local"            # local | development | production
INVICTUS_SERVER_START_LOCAL="8000"
INVICTUS_SERVER_START_DEVELOPMENT="8000"
INVICTUS_SERVER_START_LIVE="8000"

# Database (local)
DATABASE_HOST="localhost"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_DB="invictus"

# Database (development / production) — used when INVICTUS_SERVER_LINE != local
DATABASE_DEV_HOST=""
DATABASE_DEV_USER=""
DATABASE_DEV_PASSWORD=""
DATABASE_DEV_DB=""
DATABASE_PRO_HOST=""
DATABASE_PRO_USER=""
DATABASE_PRO_PASSWORD=""
DATABASE_PRO_DB=""

JWT_SECRET_KEY=""

SEED_SUPER_ADMIN_TITLE="Mr"
SEED_SUPER_ADMIN_USERNAME=""
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_MOBILE=""
SEED_SUPER_ADMIN_PASSWORD=""
SEED_SUPER_ADMIN_COUNTRY_CODE="+91"

RUNO_WEBHOOK_API_KEY=""
RUNO_WEBHOOK_CLIENT_KEY=""
RUNO_WEBHOOK_IP_WHITELIST=""
RUNO_WEBHOOK_RATE_LIMIT_MAX="60"

GOOGLE_CHAT_WEBHOOK_URL=""

# --- Careers location geocoding (Geoapify) --------------------------------
# Backend only. NEVER expose to the frontend / NEXT_PUBLIC_*.
# Both are OPTIONAL: with no key or GEOAPIFY_GEOCODING_ENABLED != true, careers
# applications still submit and location resolution falls back to local
# normalization + a small alias map (state may be stored as null).
GEOAPIFY_API_KEY=""
GEOAPIFY_GEOCODING_ENABLED="true"
